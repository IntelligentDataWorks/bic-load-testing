# Copy to .env and fill in real values locally. Never commit the real .env file.
TARGET_HOST=http://localhost:8000
# BIC_AUTH_TOKEN is short-lived -- don't store a real value here. Populate it in your
# shell via scripts/get-databricks-token.ps1 (Databricks OAuth U2M) before running
# against a deployed, auth-enforcing app. Leave unset for local/no-auth FastAPI runs.
BIC_AUTH_TOKEN=
# Set to false to skip the stateful chat/session/visualization flow and only run read-only checks.
BIC_ENABLE_FULL_FLOW=true
# Required by scenarios/serving_endpoint_smoke.py: the caller's Databricks user id/email,
# forwarded in custom_inputs.user_id. Never hardcode this.
BIC_TEST_USER_ID=
